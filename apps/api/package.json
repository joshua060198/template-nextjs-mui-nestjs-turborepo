    "passport-jwt": "^4.0.1",
    "pg": "^8.20.0",
    "rxjs": "^7.8.2",
    "sharp": "^0.34.5",
    "ssh2-sftp-client": "^12.1.1",
    "typeorm": "^0.3.28",
    "typeorm-extension": "^3.9.0",
    "ua-parser-js": "^2.0.9",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.39.1",
    "@nestjs/cli": "^11.0.17",
    "@nestjs/common": "^11.1.18",
    "@nestjs/schematics": "^11.0.10",
    "@nestjs/testing": "^11.1.18",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
